{
  "name": "@hollis-labs/chatstream-client",
  "version": "0.1.0",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "A resumable client for chat streams over SSE: reconnects with Last-Event-ID, de-duplicates by seq, reports gaps, and detects stalls by frame arrival.",
  "keywords": [
    "chat",
    "stream",
    "sse",
    "resumable",
    "llm"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hollis-labs/chatstream-client.git"
  },
  "homepage": "https://github.com/hollis-labs/chatstream-client#readme",
  "bugs": {
    "url": "https://github.com/hollis-labs/chatstream-client/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.js",
    "test:run": "npm run build && node --test test/*.test.js",
    "gen": "cd tools/gen && go run . -root ../.. -output ../../src/generated/chatstream-types.generated.ts",
    "gen:check": "node scripts/gen-check.mjs",
    "gen:go-test": "cd tools/gen && go test -count=1 ./..."
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "jsdom": "^27.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~6.0.2"
  }
}
